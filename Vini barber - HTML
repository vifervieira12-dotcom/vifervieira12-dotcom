<!-- Declaração do tipo de documento: instrui o navegador que a página utiliza o padrão HTML5 -->
<!DOCTYPE html>
<!-- Tag raiz que engloba todo o documento HTML, com o atributo lang definindo o idioma como Português do Brasil -->
<html lang="pt-br">
<!-- Elemento que contém os metadados e configurações da página (não visíveis diretamente ao usuário) -->
<head>
    <!-- Define a codificação de caracteres como UTF-8, garantindo suporte a acentos e caracteres especiais -->
    <meta charset="UTF-8">
    <!-- Configura a viewport para garantir renderização responsiva e escala correta em dispositivos móveis -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Define o título da página exibido na aba do navegador e nos motores de busca -->
    <title>Vini Barber - Estilo & Tradição</title>
    <!-- Vincula a folha de estilos externa (style.css) ao documento HTML -->
    <link rel="stylesheet" href="style.css">
<!-- Fechamento da tag de cabeçalho técnico/metadados -->
</head>
<!-- Elemento que abriga todo o conteúdo visível da página web -->
<body>
    <!-- Comentário indicativo da seção de cabeçalho da página -->
    <!-- Cabeçalho -->
    <!-- Tag semântica para o cabeçalho introdutório da página com a classe CSS 'cabecalho' -->
    <header class="cabecalho">
        <!-- Título principal de nível 1 com o nome da marca/empresa -->
        <h1>Vini Barber</h1>
        <!-- Tag semântica que delimita a área de navegação por links do site -->
        <nav>
            <!-- Início da lista não ordenada que organiza os itens do menu -->
            <ul>
                <!-- Item da lista contendo o link para a seção inicial -->
                <li><a href="#">Início</a></li>
                <!-- Item da lista contendo o link para a seção Sobre -->
                <li><a href="#sobre">Sobre</a></li>
                <!-- Item da lista contendo o link para a seção de Serviços -->
                <li><a href="#servicos">Serviços</a></li>
                <!-- Item da lista contendo o link para a seção de Contatos -->
                <li><a href="#contato">Contatos</a></li>
            <!-- Fechamento da lista do menu -->
            </ul>
        <!-- Fechamento da barra de navegação -->
        </nav>
    <!-- Fechamento da tag de cabeçalho principal -->
    </header> 
    <!-- Seção temática de destaque/banner principal com a classe CSS 'hero' -->
    <section class="hero">
        <!-- Divisão genérica (container) para agrupar e organizar os textos do banner -->
        <div>
            <!-- Título de nível 2 com o slogan/chamada de impacto -->
            <h2>Estilo e tradição para o homem moderno</h2>
            <!-- Parágrafo complementar de apoio com descrição resumida e emojis -->
            <p>Cortes clássicos, degradê perfeito e barba na toalha quente. ✂️💈</p>
        <!-- Fechamento do container de texto do hero -->
        </div>
    <!-- Fechamento da seção hero/banner -->
    </section>
    <!-- Tag semântica que envolve o conteúdo principal exclusivo e central desta página -->
    <main>
        <!-- Seção 'Sobre Nós' identificada por id para âncoras e estilizada pela classe 'secao' -->
        <section class="secao" id="sobre">
            <!-- Título de nível 2 da seção Sobre Nós -->
            <h2>Sobre Nós</h2>
            <!-- Parágrafo descritivo sobre a barbearia, sua proposta e valores -->
            <p>A Vini Barber resgata a essência das barbearias clássicas, oferecendo um atendimento de excelência com profissionais mestres na tesoura e navalha. Nosso espaço foi pensado para você relaxar, cuidar do seu visual com conforto e exclusividade.</p>
        <!-- Fechamento da seção Sobre Nós -->
        </section>

        <!-- Seção de serviços prestados com id para navegação interna -->
        <section class="secao" id="servicos">
            <!-- Título de nível 2 da seção de Serviços -->
            <h2>Nossos Serviços</h2>
            <!-- Container estrutural que agrupa os cards individuais de serviços -->
            <div class="container-servicos">

                <!-- Card individual do serviço de corte -->
                <div class="servico">
                    <!-- Título nível 3 com o nome do serviço e ícone decorativo -->
                    <h3>✂️ Corte de Cabelo</h3>
                    <!-- Descrição das atividades incluídas no corte -->
                    <p>Cortes clássicos, modernos, degradê (fade) e social, finalizados com pomada de alta qualidade.</p>
                <!-- Fechamento do card de corte -->
                </div>

                <!-- Card individual do serviço de barba -->
                <div class="servico">
                    <!-- Título nível 3 com o nome do serviço e ícone -->
                    <h3>🧔 Barba Tradicional</h3>
                    <!-- Descrição dos procedimentos de barba -->
                    <p>Barboterapia completa com toalha quente, massagem facial e alinhamento perfeito na navalha.</p>
                <!-- Fechamento do card de barba -->
                </div>

                <!-- Card individual do combo -->
                <div class="servico">
                    <!-- Título nível 3 com o nome do combo -->
                    <h3>💈 Combo VIP (Corte + Barba)</h3>
                    <!-- Descrição dos serviços incluídos no combo -->
                    <p>O pacote completo para o seu visual, incluindo lavagem, corte, barba e uma incrível experiência.</p>
                <!-- Fechamento do card de combo -->
                </div>

            <!-- Fechamento do container aglutinador de cards -->
            </div>
        <!-- Fechamento da seção de Serviços -->
        </section>

        <!-- Seção do formulário de contato/agendamento com classes 'secao' e 'contato' e identificador id -->
        <section class="secao contato" id="contato">
            <!-- Título de nível 2 orientando a ação de agendamento -->
            <h2>Agende seu Horário</h2>
            <!-- Parágrafo de instrução para o preenchimento dos dados -->
            <p>Preencha os dados abaixo e nossa equipe confirmará seu agendamento.</p>
            <!-- Tag que engloba os campos de entrada de dados do formulário -->
            <form>
                <!-- Campo de entrada de texto para o nome -->
                <input type="text" name="nome" id="nome" placeholder="Seu Nome">
                <!-- Campo específico para endereço de e-mail -->
                <input type="email" name="email" id="email" placeholder="Seu E-mail">
                <!-- Campo de texto para informar o assunto/data -->
                <input type="text" name="assunto" id="assunto" placeholder="Data e Horário de preferência">
                <!-- Área de texto multilinha para mensagem -->
                <textarea name="mensagem" id="mensagem" placeholder="Alguma observação?"></textarea>
                <!-- Botão de submissão do formulário -->
                <button type="submit" class="btn-enviarForm">Agendar Agora</button>
            <!-- Fechamento da tag de formulário -->
            </form>
        <!-- Fechamento da seção de Contato -->
        </section>
    <!-- Fechamento do conteúdo principal da página -->
    </main>
    <!-- Tag semântica que define o rodapé institucional do documento -->
    <footer>
        <!-- Parágrafo com os direitos autorais usando a entidade &copy; (símbolo ©) -->
        <p>&copy; 2026 Vini Barber - Todos os direitos reservados</p>
    <!-- Fechamento do rodapé -->
    </footer>
<!-- Fechamento do corpo da página -->
</body>
<!-- Fechamento da tag raiz do documento HTML -->
</html>
